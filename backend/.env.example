# Copy this file to .env and fill in all values before starting the server.

# Required — server refuses to start without this. Use a long random string (32+ chars).
JWT_SECRET=your_random_secret_here

# Required for AI generation — get your free key at https://aistudio.google.com
# Free tier: 1M tokens/day, 15 RPM, 1500 req/day — no billing required
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Set to "true" to skip real AI calls and return placeholder data (useful for UI dev)
# DEMO_MODE=true

# Server port (default: 3001)
PORT=3001

# Allowed CORS origin for the frontend (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
